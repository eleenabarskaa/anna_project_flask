# Скопируйте в .env и заполните, когда появятся доступы.

FLASK_ENV=development
SECRET_KEY=change-me

# Источник данных: memory (заглушки) | sql (появится при подключении БД)
REPOSITORY_BACKEND=memory

# --- подключения (пока не используются) ---
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/meridian
# SEARCH_URL=http://localhost:9200
# REDIS_URL=redis://localhost:6379/0
# INTEGRATIONS_TIMEOUT=15

# --- параметры домена ---
TRIGGERS_PER_PAGE=8
DEFAULT_LOOKBACK_MONTHS=3
DESK_USER_NAME=Anna Kaufmann
DESK_USER_LOCATION=Zurich · Desk 4

# Скопируйте в .env и заполните. Файл .env в .gitignore — в репозиторий не попадёт.

FLASK_ENV=development
SECRET_KEY=change-me

# Источник данных: memory (демо-данные) | supabase (реальная таблица triggers)
REPOSITORY_BACKEND=supabase

# --- Supabase ---
# SUPABASE_SECRET_KEY — service-role ключ: обходит RLS, никогда не коммитить
# и не отдавать в браузер. Только сервер.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_TRIGGERS_TABLE=triggers
SUPABASE_TRIGGER_JOBS_TABLE=trigger_jobs
SUPABASE_DOCUMENTS_TABLE=researched_documents
DOCUMENTS_PER_PAGE=20

# --- Кнопка Find triggers на странице Triggers ---
# Вебхук n8n: принимает собранные статьи, классифицирует их LLM-нодой
# и пишет результат в таблицы triggers / trigger_jobs.
N8N_TRIGGERS_SCAN_WEBHOOK_URL=https://<n8n>/webhook/scan-triggers
N8N_WEBHOOK_TIMEOUT=15
SCAN_POLL_TIMEOUT=300
SCAN_POLL_INTERVAL=3
SCAN_DEFAULT_MONTHS=3

# --- заготовки под будущие подключения ---
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres
# REDIS_URL=redis://localhost:6379/0
# INTEGRATIONS_TIMEOUT=15

# --- параметры домена ---
TRIGGERS_PER_PAGE=8
DEFAULT_LOOKBACK_MONTHS=3
DESK_USER_NAME=Anna Kaufmann
DESK_USER_LOCATION=Zurich · Desk 4
